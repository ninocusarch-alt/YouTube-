# ── ASR 协议：代码会按模型名自动选择，一般无需手动指定 ────────────────
# A) OpenAI Realtime：qwen3-asr-flash-realtime → /api-ws/v1/realtime + session.update
# B) DashScope Streaming：qwen-audio-3.1-asr-flash-streaming（及 *-asr-flash-message）
#    → /api-ws/v1/inference + run-task + 二进制 PCM 帧
# 使用百炼 MaaS 专属实例时设置 DASHSCOPE_BASE_URL，翻译 HTTP 端点与 ASR
# WebSocket 端点都会据此自动推导；此时不要显式写下面两个 *_URL，否则不会自动推导。
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 仅在要覆盖自动推导时才设置（设置后 DASHSCOPE_BASE_URL 对该项不再生效）
# QWEN_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# QWEN_TRANSLATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

QWEN_ASR_MODEL=qwen3-asr-flash-realtime
# QWEN_ASR_PROTOCOL=            # 留空=按模型自动；可写 realtime / streaming 强制指定
QWEN_ASR_LANGUAGE=en
QWEN_ASR_SAMPLE_RATE=16000
QWEN_VAD_SILENCE_MS=400
QWEN_ASR_VAD_THRESHOLD=0.0
QWEN_TRANSLATION_MODEL=qwen-plus
QWEN_TRANSLATION_TIMEOUT_SECONDS=12
QWEN_CHAT_MODEL=qwen-plus
TRANSLATION_WORKERS=2
SEGMENT_MIN_WORDS=4
SEGMENT_MAX_WORDS=18
SEGMENT_MAX_WAIT_SECONDS=1.6
SESSION_MAX_SEGMENTS=5000
SUMMARY_BATCH_SEGMENTS=20
# Leave empty to store history in backend/data/video_companion.db
SESSION_DATABASE_PATH=
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,chrome-extension://*
